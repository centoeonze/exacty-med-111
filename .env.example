# Express AuthService bootstrap (creates User with bcrypt if missing).
# Also used by Playwright login helpers. Not read by Vite.
CMS_USERNAME=
CMS_PASSWORD=
# CMS_SESSION_SECRET=change-me-in-production

# Stage 10A — API is the only storage / auth / upload path
STORAGE_PROVIDER=api
CMS_STORAGE_PROVIDER=api
VITE_STORAGE_PROVIDER=api
VITE_CMS_STORAGE_PROVIDER=api

CMS_API_PORT=3001
CMS_API_CORS_ORIGIN=http://localhost:8080
