# Express AuthService bootstrap (creates User with bcrypt if missing).
# Also used by Playwright login helpers and by local auth (static build).
CMS_USERNAME=
CMS_PASSWORD=
# CMS_SESSION_SECRET=change-me-in-production

# Auth: local (no backend — static Hostinger) | api (Express /api/auth/*)
CMS_AUTH_PROVIDER=local
VITE_CMS_AUTH_PROVIDER=local

# Storage: local (localStorage) | api (Express /api/storage)
# Use local on static hosting; switch to api when Express is published.
CMS_STORAGE_PROVIDER=local
VITE_CMS_STORAGE_PROVIDER=local
STORAGE_PROVIDER=local
VITE_STORAGE_PROVIDER=local

CMS_API_PORT=3001
CMS_API_CORS_ORIGIN=http://localhost:8080
