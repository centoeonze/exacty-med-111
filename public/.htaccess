# Hostinger / Apache / LiteSpeed — max request body 60 MB for CMS PDF uploads.
# If HTML 413 persists after deploy, the limit is enforced above this file
# (Hostinger edge / VPS nginx). See server/nginx-hostinger-proxy.conf.
LimitRequestBody 62914560

<IfModule mod_security.c>
  SecRequestBodyLimit 62914560
  SecRequestBodyNoFilesLimit 62914560
</IfModule>

<IfModule LiteSpeed>
  MaxReqBodySize 62914560
</IfModule>

# SPA fallback: do not send /api or /uploads to index.html (pass through to Node/API).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^api(?:/|$) - [L]
  RewriteRule ^uploads(?:/|$) - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
