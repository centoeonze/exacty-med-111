# Hostinger / Apache / LiteSpeed — raise body limit for CMS PDF uploads (60 MB).
# Without this, the reverse proxy returns HTML 413 before Express/Multer.
LimitRequestBody 62914560

# Some Hostinger stacks enforce body size via ModSecurity (ignore if module absent).
<IfModule mod_security.c>
  SecRequestBodyLimit 62914560
  SecRequestBodyNoFilesLimit 62914560
</IfModule>

<IfModule LiteSpeed>
  MaxReqBodySize 62914560
</IfModule>

# SPA fallback must NOT rewrite /api/* or /uploads/* to index.html.
# Do NOT force R=404 on /api — that blocks Express uploads (HTML 404 instead of JSON).
# Pass those paths through so Node / reverse-proxy can handle them.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^api(?:/|$) - [L]
  RewriteRule ^uploads(?:/|$) - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
