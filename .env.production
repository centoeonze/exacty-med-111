# Baked into Vite production builds (EasyPanel / Hostinger Node).
# Storage + auth use Express /api/* — requires the Node Dockerfile (not nginx-static).

CMS_AUTH_PROVIDER=api
VITE_CMS_AUTH_PROVIDER=api

CMS_STORAGE_PROVIDER=api
VITE_CMS_STORAGE_PROVIDER=api
STORAGE_PROVIDER=api
VITE_STORAGE_PROVIDER=api
