# Production build defaults.
# Hostinger Node (recommended for uploads): `npm run build:hostinger` then
# `npm run start:hostinger` — Express serves dist/ + always registers /api/*.
# Static-only Hostinger has no Express; /api/* will 404 (uploads will fail).
#
# Committed so `npm run build` (mode=production) resolves storage from files
# even when the private `.env` file is absent from the deploy machine.

CMS_AUTH_PROVIDER=local
VITE_CMS_AUTH_PROVIDER=local

CMS_STORAGE_PROVIDER=local
VITE_CMS_STORAGE_PROVIDER=local
STORAGE_PROVIDER=local
VITE_STORAGE_PROVIDER=local
