# Production build defaults for `vite build` / `build:hostinger`.
#
# Hostinger MUST use Node.js (not static-only hosting):
#   1) npm run build:hostinger
#   2) Start command: npm run start:hostinger
# Express then serves dist/ and always registers /api/health + /api/assets/upload.
#
# Static-only Hostinger has no Express — /api/* returns 404 and uploads fail.

CMS_AUTH_PROVIDER=local
VITE_CMS_AUTH_PROVIDER=local

CMS_STORAGE_PROVIDER=local
VITE_CMS_STORAGE_PROVIDER=local
STORAGE_PROVIDER=local
VITE_STORAGE_PROVIDER=local
