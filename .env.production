# Production SPA (Vercel / Hostinger static) — no Express backend.
# Committed so `npm run build` (mode=production) always resolves storage=local
# even when the private `.env` file is absent from the deploy machine.
#
# CMS login credentials are NOT committed. Set them in the Vercel dashboard
# (Project → Settings → Environment Variables) for Production:
#   CMS_USERNAME=...
#   CMS_PASSWORD=...
#
# To enable ApiStorage later (Express published), change these to `api`
# or build with `--mode api` / `--mode staging` (see .env.api / .env.staging).

CMS_AUTH_PROVIDER=local
VITE_CMS_AUTH_PROVIDER=local

CMS_STORAGE_PROVIDER=local
VITE_CMS_STORAGE_PROVIDER=local
STORAGE_PROVIDER=local
VITE_STORAGE_PROVIDER=local
